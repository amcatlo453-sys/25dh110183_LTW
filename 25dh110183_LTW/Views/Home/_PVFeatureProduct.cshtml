@model _25dh110183_LTW.Models.ViewModel.HomeProductVM

@using System.Linq;
<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />


<!-- Hiển thị danh sách sản phẩm -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h2>Sản phẩm nổi bật</h2>
        <ul class="feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <li class="product-item">
                    <div>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)" />
                        </a>
                    </div>

                    <div>
                        <p class="prodPrice">@product.ProductPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ</p>

                        <p class="prodName">
                            @Html.DisplayFor(modelItem => product.ProductName)
                        </p>

                        <p class="prodCate">
                            @Html.DisplayFor(modelItem => product.Category.CategoryName)
                        </p>

                        <p class="prodSale">
                            Đã bán: @Html.DisplayFor(modelItem => product.OrderDetails.Count)
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>
}

