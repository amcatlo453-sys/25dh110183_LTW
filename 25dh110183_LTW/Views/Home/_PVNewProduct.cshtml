@model _25dh110183_LTW.Models.ViewModel.HomeProductVM
@using PagedList.Mvc
@using System.Linq;

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<!-- Hiển thị danh sách sản phẩm -->
@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid listProduct">
        <h2>Sản phẩm mới</h2>

        <ul class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <li class="product-item">
                    <div>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)" />
                        </a>
                    </div>

                    <div>
                        <p class="prodPrice">@product.ProductPrice.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) đ</p>

                        <p class="prodName">
                            @Html.DisplayFor(modelItem => product.ProductName)
                        </p>

                        <p class="prodSale">
                            @Html.DisplayFor(modelItem => product.OrderDetails.Count)
                        </p>

                        <p>Đã bán: @Html.DisplayFor(modelItem => product.OrderDetails.Count)</p>
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- Hiển thị phần trang -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new
        {
            page,
            searchTerm = Model.SearchTerm
        }))
    </div>
}
else
{
    <p>Không tìm được sản phẩm nào phù hợp.</p>
}
