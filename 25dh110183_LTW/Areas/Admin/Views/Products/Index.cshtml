@model _25dh110183_LTW.Models.ViewModel.ProductSeachVM

@{
    ViewBag.Title = "Danh Sách Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        .search-container {
            padding-top: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>
<body>
    @*@ from tiem kiem@*@
    @using (Html.BeginForm("Index", "Products", FormMethod.Get))
    {
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." })
            @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", placeholder = "Giá tối thiểu...", type = "number" })
            @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", placeholder = "Giá tối đa...", type = "number" })
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
        <div class="form-group oder-cotainer">
            Sắp Xếp Theo:
            @Html.ActionLink("Tên Tăng dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm }) |
            @Html.ActionLink("Tên Giảm dần", "Index", new { sortOrder = "name_desc", searchTerm = Model.SearchTerm }) |
            @Html.ActionLink("Giá Tăng dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm }) |
            @Html.ActionLink("Giá Giảm dần", "Index", new { sortOrder = "name_asc", searchTerm = Model.SearchTerm }) |

        </div>
}
    @Html.Partial("ProductListPV", Model)
</body>
</html>