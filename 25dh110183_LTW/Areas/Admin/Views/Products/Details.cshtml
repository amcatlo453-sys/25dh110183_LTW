@model _25dh110183_LTW.Models.Product

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<head>
    <style>
        img {
            height: 250px;
            max-width: 250px;
        }
    </style>
</head>
<h2>Chi Tiết Sản Phẩm</h2>

<div>

    <hr />
    <div class="dl-horizontal">
        <div class="col-md-4">
            <img src="@Html.DisplayFor(model => model.ProductImage)"/>
        </div>
        <div class="col-sm-8">
            <dt>
                Tên Sản Phẩm
            </dt>

            <dd>
                @Html.DisplayFor(model => model.ProductName)
            </dd>

            <dt>
                Đơn Giá
            </dt>

            <dd>
                @Html.DisplayFor(model => model.ProductPrice)
            </dd>

            <dt>
                Mô tả Sản Phẩm
            </dt>
            <dd>
                @Html.DisplayFor(model => model.ProductDescription)
            </dd>

            <dt>
                Danh Mục
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Category.CategoryName)
            </dd>

        </div>
    </div>
</div>
<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-primary btn-sm" })
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
</p>
