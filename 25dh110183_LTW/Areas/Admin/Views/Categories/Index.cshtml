@model IEnumerable<_25dh110183_LTW.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Danh Sách Danh Mục</h2>

<p>
    @Html.ActionLink("Thêm mới ", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table bg-info" >
    <tr>
        <th class="bg-success">
            @*@Html.DisplayNameFor(model => model.CategoryName)*@
            Tên Danh Mục
        </th>
        <th class="bg-success"></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CategoryName)
        </td>
        <td>
            @Html.ActionLink("Cập Nhật", "Edit", new { id=item.CategoryID }, new { @class = "btn btn-sm btn-warning btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id=item.CategoryID }, new { @class = "btn btn-sm btn-danger btn-sm" })
        </td>
    </tr>
}

</table>
